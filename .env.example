# ---------------------------------------------------------------------------
# Hello Cat web terminal - environment template
#
#   cp .env.example .env
#
# Never commit .env. It holds the OAuth2 client secret and the flag secret.
# ---------------------------------------------------------------------------

# Discord application id. The terminal signs operators in with Discord OAuth2,
# so this is the Application ID from the Discord developer portal.
# It is the same value as the bot's CLIENT_ID unless the terminal uses its own
# Discord application (then set WEB_CLIENT_ID below).
CLIENT_ID=

# OAuth2 client secret of the Discord application
# (developer portal -> General Information -> Client Secret).
# This is NOT the bot token. The two must never be the same value.
DISCORD_CLIENT_SECRET=

# OAuth2 client id, only when the terminal uses a separate Discord application
# than the bot. Defaults to CLIENT_ID.
WEB_CLIENT_ID=

# HMAC key for the challenge flags. At least 16 characters.
# It MUST match the FLAG_SECRET of the Discord bot, otherwise the terminal
# computes different hashes than the bot and no submission verifies.
FLAG_SECRET=

# Secret that signs the session cookie. At least 16 characters.
# Falls back to FLAG_SECRET when unset; a dedicated value is recommended.
SESSION_SECRET=

# Guild the operator must be a member of when WEB_REQUIRE_GUILD=true.
GUILD_ID=

# The data directory shared with the Discord bot. The default is
# src/storage/data, i.e. the store inside this repository. Point it at the
# bot's directory to share progress between the two processes:
#   DATA_DIR=/opt/hellocat-bot/src/storage/data
DATA_DIR=src/storage/data

# Log directory.
LOG_DIR=logs

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port and bind address. PaaS platforms (Railway, Render, Fly) inject PORT,
# which is used when WEB_PORT is unset.
WEB_PORT=8080
WEB_HOST=0.0.0.0

# Public address of the site. The root serves the landing page and /terminal
# serves the application.
WEB_BASE_URL=https://terminal.example.com

# OAuth2 redirect URI. Defaults to WEB_BASE_URL + /auth/callback. Leave empty
# to derive it from the host the browser used.
WEB_REDIRECT_URI=

# The official website of the project. It is written in the copyright of the
# landing page, because lookalike domains are the usual way people get
# phished.
OFFICIAL_SITE_URL=https://helloc.at

# Invite to the Discord server. This is the primary call to action of the
# landing page. Defaults to https://discord.gg/<GUILD_ID>.
DISCORD_INVITE_URL=https://discord.gg/your-invite

# ---------------------------------------------------------------------------
# Session and access control
# ---------------------------------------------------------------------------

# Require membership of the Discord guild before granting access.
WEB_REQUIRE_GUILD=false

# 'auto' (default), 'true' or 'false'. 'auto' marks the cookie Secure for
# HTTPS requests, including behind a reverse proxy.
WEB_COOKIE_SECURE=auto

# Honour X-Forwarded-Proto from a loopback proxy or tunnel. Default true.
WEB_TRUST_PROXY=true

# Cookie domain. Empty (default) keeps the cookie host-only.
WEB_COOKIE_DOMAIN=

# Session lifetime in seconds. Default 43200 (12 hours).
WEB_SESSION_TTL=43200

# ---------------------------------------------------------------------------
# Discord bot (optional)
# ---------------------------------------------------------------------------

# Only needed when the terminal announces something on its own. The terminal
# reuses the bot's services for the shared store, but it never connects to the
# gateway.
DISCORD_TOKEN=
